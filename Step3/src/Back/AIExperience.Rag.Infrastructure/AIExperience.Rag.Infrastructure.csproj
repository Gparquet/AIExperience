<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Extraction audio depuis vidéo (100% local) -->
    <PackageReference Include="FFMpegCore" Version="5.*" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.8.0" />
    <!-- Transcription audio → texte via modèle Whisper local -->
